FROM python:3.11-slim

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
COPY dashboard/requirements.txt dashboard-requirements.txt

# Install dependencies (bot deps + dashboard-only extras)
RUN pip install --no-cache-dir -r requirements.txt -r dashboard-requirements.txt

# Copy application code
COPY . .

# Railway assigns $PORT at runtime
ENV PORT=8888
EXPOSE 8888

# Run the monitoring dashboard, not the trading bot.
# Create this as a SEPARATE Railway service pointing at this Dockerfile
# (Settings -> Build -> Dockerfile Path = Dockerfile.dashboard), sharing the
# same Volume/STATE_FILE as the bot service so it can read live state.
CMD ["sh", "-c", "uvicorn dashboard.server:app --host 0.0.0.0 --port ${PORT}"]
