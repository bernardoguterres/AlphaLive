# Alpaca API Configuration
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Strategy Configuration
STRATEGY_CONFIG=configs/example_strategy.json
# STRATEGY_CONFIG_DIR=configs/production   # multi-strategy mode - alternative to STRATEGY_CONFIG

# AlphaSignal Integration (pre-execution sentiment gate - fails open if unreachable)
ALPHASIGNAL_URL=http://localhost:8000
ALPHASIGNAL_ENABLED=true
ALPHASIGNAL_API_KEY=            # must match AlphaSignal's own ALPHASIGNAL_API_KEY exactly
ALPHASIGNAL_SENTIMENT_THRESHOLD=-0.3
ALPHASIGNAL_TIMEOUT_SECONDS=3.0

# Monthly Greenblatt Screener (optional - unset SCREENER_UNIVERSE disables it)
# SCREENER_UNIVERSE=AAPL,MSFT,GOOGL
# SCREENER_TOP_N=15
# SCREENER_OUTPUT_PATH=screener_output.json

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=json          # set to enable structured JSON logging
# ENABLE_FILE_LOGS=true    # daily rotating log files under LOG_DIR
# LOG_DIR=./logs

# Trading Controls
DRY_RUN=false
TRADING_PAUSED=false
# ENABLE_BEAR_MARKET_FILTER=true    # default true - blocks BUYs when price < declining SMA_200
# DRAWDOWN_ALERT_PCT=3              # Telegram alert when intraday drawdown from peak exceeds this

# State Management
STATE_FILE=/tmp/alphalive_state.json
PERSISTENT_STORAGE=false

# Health Check (for Railway)
HEALTH_PORT=8080
HEALTH_SECRET=change_me_to_a_random_string

# Dashboard (dashboard/server.py - separate process, shares this same .env)
# DASHBOARD_PASSWORD=              # unset = no auth, HTTP Basic Auth if set
# RAILWAY_API_TOKEN=               # enables one-click redeploy button
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
